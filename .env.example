# Copy this file to `.env` and fill in values. `.env` is gitignored.

# Free Chicago Data Portal (Socrata) app token — optional but speeds up ingestion.
# Get one at https://data.cityofchicago.org (Profile -> Developer Settings).
SOCRATA_APP_TOKEN=

# Area to build the street graph for. Use a smaller area for a lighter first run,
# e.g. "Near North Side, Chicago, Illinois".
SAFEROUTE_PLACE=Chicago, Illinois

# How many trailing months of crime/crash data to ingest.
SAFEROUTE_MONTHS=12

# Max rows to pull per dataset (safety cap for local machines).
SAFEROUTE_MAX_ROWS=200000
